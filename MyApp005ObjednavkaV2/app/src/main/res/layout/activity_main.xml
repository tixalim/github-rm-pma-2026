<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/header_title"
        android:textAlignment="center"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvOrderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/order_question"
        android:textAlignment="center"
        android:textSize="20sp" />

    <RadioGroup
        android:id="@+id/rgSperk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSperk3"
            android:layout_width="102dp"
            android:layout_height="wrap_content"
            android:text="@string/bracelet_tree" />

        <RadioButton
            android:id="@+id/rbSperk1"
            android:layout_width="101dp"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/bracelet_heart" />

        <RadioButton
            android:id="@+id/rbSperk2"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:text="@string/bracelet_infinity" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/cbBTN1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/extra_engraving" />

    <CheckBox
        android:id="@+id/cbBTN2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/extra_gift_box" />

    <CheckBox
        android:id="@+id/cbBTN3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/extra_long_chain" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/myview_order" />

    <TextView
        android:id="@+id/tvOrder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:background="#FFF59D"
        android:paddingLeft="16dp"
        android:text="@string/myview_order_summary" />

    <ImageView
        android:id="@+id/ivSperk"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sperk_1" />


</LinearLayout>